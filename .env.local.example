# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> Data API
#   SUPABASE_URL is the "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret, NOT the anon key.
#   It bypasses RLS and is only ever read server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Set a hard spend cap on this key in the console before the link
# is public -- that cap, not a rate limiter, is what bounds the actual risk.
ANTHROPIC_API_KEY=